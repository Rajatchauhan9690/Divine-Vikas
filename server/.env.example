NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/divine-vikas

# Replace both values with unique random secrets (at least 32 characters in production)
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_DAYS=7

CLIENT_ORIGIN=http://localhost:5173
IMAGE_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
COOKIE_SAME_SITE=lax

# SMTP settings for password reset, order confirmation, and class booking emails
# Use a verified sender domain with provider-configured SPF, DKIM, and DMARC DNS records.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary credentials for product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when creating the initial admin account
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Optional Cashfree configuration; use sandbox credentials for development
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_URL=

# Cashfree refunds use the same Payment Gateway API credentials.

# Optional Shiprocket shipping, AWB, label, and tracking integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
