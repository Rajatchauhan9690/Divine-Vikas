NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=

# Replace both values with unique random secrets (at least 32 characters in production)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_DAYS=

CLIENT_ORIGIN=
IMAGE_ORIGINS=
# Development only; production always uses SameSite=None for the Vercel client.
COOKIE_SAME_SITE=

# SMTP settings for password reset, order confirmation, and class booking emails
# Use a verified sender domain with provider-configured SPF, DKIM, and DMARC DNS records.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary credentials for product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when creating the initial admin account
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Cashfree configuration; use sandbox credentials for development
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_URL=

# Cashfree refunds use the same Payment Gateway API credentials.

# Required for customer delivery quotes at checkout and Shiprocket shipping.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=
# Product shipping weights are managed per product in Admin. Enter packed weight per unit.
# Optional automatic shipment booking after successful Cashfree payment.
SHIPROCKET_AUTO_BOOK_PAID_ORDERS=
# Supported: lowest_cost, fastest, recommended
SHIPROCKET_COURIER_SELECTION=
# Product dimensions are managed per product in Admin.
# Orders above this number of units are sent to manual shipping.
SHIPROCKET_AUTO_BOOK_MAX_ITEMS=
